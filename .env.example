# AMIP Configuration Environment
ENVIRONMENT=development
DEBUG=true
MOCK_MODE=true
API_V1_STR=/api/v1
PROJECT_NAME="Antarctic Mission Intelligence Platform (AMIP) POC"

# Database Configuration (PostgreSQL / PostGIS in Docker, SQLite fallback for unit tests)
DATABASE_URL=postgresql+asyncpg://amip_user:amip_password@localhost:5432/amip_db
DATABASE_TEST_URL=sqlite+aiosqlite:///:memory:

# Redis / Caching / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
USE_CELERY=false

# Paths
DATA_DIR=data
MODELS_DIR=models

# Logging
LOG_LEVEL=INFO
